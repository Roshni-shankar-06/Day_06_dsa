class Solution:

  def getPermutation(self, n: int, k: int) -> str:
    nums = list(range(1, n + 1))
    fact = [1] * (n + 1)
    for i in range(2, n + 1):
      fact[i] = fact[i - 1] * i

    k -= 1  # Convert to 0-indexed
    ans = []

    for i in range(n - 1, -1, -1):
      idx = k // fact[i]
      ans.append(str(nums[idx]))
      nums.pop(idx)
      k %= fact[i]

    return "".join(ans)

