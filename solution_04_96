class Solution:
    def numTrees(self, n: int) -> int:
        # dp[i] stores the number of unique BSTs with i nodes
        dp = [1, 1] + [0] * (n - 1)
        
        for i in range(2, n + 1):
            for j in range(i):
                # Left subtree has j nodes, right subtree has i - j - 1 nodes
                dp[i] += dp[j] * dp[i - j - 1]
                
        return dp[n]
      
        
  
           
          
                
      
